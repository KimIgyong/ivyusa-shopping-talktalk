# syntax=docker/dockerfile:1
# IVY TalkTalk — customer PWA (Vite static) image, staging. Served under /app/.
# Build context MUST be the repo root.

# ---- Build stage ----------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# VITE_* vars are baked at build time (vite.config.ts pins base to /app/).
ARG VITE_API_BASE_URL
ARG VITE_SHOP_DOMAIN
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_SHOP_DOMAIN=${VITE_SHOP_DOMAIN}

COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/widget/package.json apps/widget/
COPY apps/pwa/package.json apps/pwa/
COPY packages/types/package.json packages/types/
COPY packages/common/package.json packages/common/

RUN npm install

COPY . .

RUN npx turbo run build --filter=@ivy/pwa...

# ---- Runtime stage (nginx static, served under /app/) ----------------------
FROM nginx:alpine AS runtime
COPY docker/staging/nginx.pwa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/pwa/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
