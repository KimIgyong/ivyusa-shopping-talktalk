# API origin incl. /api/v1 prefix (staging shown; local dev: http://<LAN-IP>:3000/api/v1)
EXPO_PUBLIC_API_BASE_URL=https://shoptalk.amoeba.site/api/v1
# Shopify storefront host rendered in the Shop tab WebView; also sent as
# shop_domain on /session/ensure (REQUIRED in a multi-tenant deployment).
EXPO_PUBLIC_SHOP_DOMAIN=ambshop-dev.myshopify.com
